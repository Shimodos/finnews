# Скопируй этот файл в .env и заполни значения. Файл .env в git не попадает.

# Ключ Claude API: https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=

# Токен бота от @BotFather и твой chat_id (узнать: finnews chat-id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательно: твой список тикеров через запятую
WATCHLIST=VOO,VT,AAPL

# Необязательно: значения по умолчанию
# FINNEWS_DB=finnews.db
# FINNEWS_SCORE_MODEL=claude-haiku-5-5
# FINNEWS_DIGEST_MODEL=claude-sonnet-5-5
# FINNEWS_MIN_SCORE=6
# Время сборок в UTC — для отсчёта «до следующего обновления» на странице
# FINNEWS_SCHEDULE=05:00,12:00,16:00,21:30
